{
  "root": true,
  "extends": [
    "next/core-web-vitals",
    "plugin:@typescript-eslint/recommended-type-checked",
    "plugin:jsx-a11y/recommended"
  ],
  "parserOptions": {
    "project": "./tsconfig.json"
  },
  "rules": {
    "@typescript-eslint/consistent-type-imports": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/no-misused-promises": [
      "error",
      { "checksVoidReturn": { "attributes": false } }
    ],
    "react/jsx-curly-brace-presence": ["warn", "never"],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/lib/supabase/admin*"],
            "importNames": ["adminClient", "createAdminClient"],
            "message": "Service-role client is server-only. Import from app/api/* or lib/admin/* only."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "NewExpression[callee.name='Date'][arguments.length=0]",
        "message": "Use nowUtc() from lib/time/ instead of new Date() — ADR-0034 single-source-of-truth."
      },
      {
        "selector": "CallExpression[callee.object.name='Date'][callee.property.name='now']",
        "message": "Use nowUtc() from lib/time/ instead of Date.now() — ADR-0034 single-source-of-truth."
      }
    ]
  },
  "overrides": [
    {
      "files": ["app/(auth)/**/actions.ts", "app/api/**/*.ts", "app/(admin)/**/_actions/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "lib/time/**/*.ts",
        "tests/**/*.ts",
        "scripts/**/*.ts",
        "scripts/**/*.mjs",
        "scripts/**/*.js"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ],
  "ignorePatterns": ["_design/**", "node_modules", ".next", "out", "coverage"]
}

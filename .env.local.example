# =================================================================
# Members Only Poker Social Club — local environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Production values live in Vercel; staging in the staging Supabase project.
# =================================================================

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Stripe (test mode for local) -----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MEMBERSHIP_AUTOPAY=     # $25/mo
STRIPE_PRICE_ID_MEMBERSHIP_INVOICE=     # $30/mo

# ----- Twilio (sandbox for local) -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ----- Resend -----
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@membersonlypokerclub.com

# ----- Sentry -----
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                       # build-time only; never NEXT_PUBLIC_
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_ENV=local

# ----- PostHog -----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----- Upstash Redis (rate limiting) -----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- App config -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local                # local | preview | staging | production
